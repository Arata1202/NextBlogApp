node_modules/.bin/lint-staged

if git diff --cached --quiet --diff-filter=DR; then
  git diff --cached --name-only --line-prefix=./ --diff-filter=ACM -z | xargs -0 -r node_modules/.bin/vitest related --project=unit --run --passWithNoTests
else
  node_modules/.bin/vitest run --project=unit
fi

if [ -z "$GOCACHE" ]; then
  export GOCACHE="$(pwd)/tmp/go-build-cache"
  mkdir -p "$GOCACHE"
fi

go test ./...

gitleaks protect --staged
