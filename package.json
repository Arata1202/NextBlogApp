{
  "name": "nextblogapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "eslint-plugin-jsx-a11y>minimatch": "3.1.5",
      "flat-cache>flatted": "3.4.2",
      "postcss": "8.5.15"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:e2e": "node scripts/e2e/build.mjs",
    "start": "pnpm dlx serve@latest out",
    "lint": "eslint src .storybook e2e scripts playwright.config.ts vitest.config.mts",
    "lint:fix": "eslint src .storybook e2e scripts playwright.config.ts vitest.config.mts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest --project=unit",
    "test:run": "vitest run --project=unit",
    "test:coverage": "vitest run --coverage --project=unit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky install",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,mts,json,css,mjs}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@next/third-parties": "^16.3.3",
    "@sentry/nextjs": "^10",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "feed": "^6.0.0",
    "highlight.js": "^11.12.0",
    "microcms-js-sdk": "^3.4.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-share": "^5.3.0",
    "react-slick": "^0.31.0",
    "remark-gfm": "^4.0.1",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chromatic": "^18.7.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
